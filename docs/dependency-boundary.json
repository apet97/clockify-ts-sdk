{
  "schemaVersion": 1,
  "purpose": "Dependency boundary contract for SDK, CLI, and MCP packages. Keeps runtime dependencies intentional and prevents generated SDK internals from leaking into sibling packages.",
  "sourceRoots": [
    "cli/src",
    "cli/tests",
    "mcp/src",
    "mcp/tests",
    "wrapper"
  ],
  "ignoredSourcePathSegments": [
    ".stryker-tmp",
    "coverage",
    "dist",
    "node_modules",
    "reports",
    "src"
  ],
  "packages": [
    {
      "id": "wrapper",
      "manifest": "wrapper/package.json",
      "lockfile": "package-lock.json",
      "lockfileVersion": 3,
      "runtimeDependencies": [],
      "peerDependencies": {},
      "requiredDevDependencies": [
        "typescript",
        "vitest",
        "tsx"
      ]
    },
    {
      "id": "cli",
      "manifest": "cli/package.json",
      "lockfile": "package-lock.json",
      "lockfileVersion": 3,
      "runtimeDependencies": [
        "cli-table3",
        "commander",
        "picocolors",
        "zod"
      ],
      "peerDependencies": {
        "clockify-sdk-ts-115": "^5.2.0"
      },
      "devDependencies": {
        "clockify-sdk-ts-115": "*"
      },
      "requiredDevDependencies": [
        "typescript",
        "vitest",
        "tsx"
      ]
    },
    {
      "id": "mcp",
      "manifest": "mcp/package.json",
      "lockfile": "package-lock.json",
      "lockfileVersion": 3,
      "runtimeDependencies": [
        "@modelcontextprotocol/node",
        "@modelcontextprotocol/server",
        "jose",
        "pg",
        "zod"
      ],
      "peerDependencies": {
        "clockify-sdk-ts-115": "^5.2.0"
      },
      "devDependencies": {
        "clockify-sdk-ts-115": "*"
      },
      "requiredDevDependencies": [
        "@modelcontextprotocol/client",
        "@modelcontextprotocol/ext-apps",
        "@modelcontextprotocol/sdk",
        "@types/pg",
        "happy-dom",
        "typescript",
        "vitest",
        "tsx"
      ]
    }
  ],
  "forbiddenRuntimeDependencies": [
    "axios",
    "lodash",
    "moment",
    "request",
    "openai",
    "@anthropic-ai/sdk"
  ],
  "forbiddenDependencyNames": [
    "fern-api",
    "@fern-api/cli",
    "@fern-api/core",
    "@fern-api/cloud",
    "stainless",
    "@stainless-api/sdk",
    "speakeasy",
    "@speakeasy-api/sdk"
  ],
  "forbiddenDependencyManifestPaths": [
    "package.json",
    "wrapper/package.json",
    "cli/package.json",
    "mcp/package.json"
  ],
  "forbiddenImportMarkers": [
    "output/ts-sdk",
    "../wrapper/src",
    "wrapper/src"
  ],
  "toolchainCompilerSplit": "SEC-5 (2026-08-09): the root lockfile hoists node_modules/typescript@5.9.3 while all three workspaces declare and resolve typescript@^7.0.2 in their own node_modules. The 5.9.3 copy satisfies typescript-eslint's peer range (>=4.8.4 <6.1.0), which does not admit TS 7 — so LINT parses the code under compiler major 5 while type-check/build/tests run under major 7. This is a known, deliberate split until typescript-eslint supports TS 7; if lint and tsc ever disagree about a construct, trust tsc and check this note before chasing the discrepancy.",
  "rootDevDependencyIntent": {
    "esbuild": "The exact root esbuild@0.28.1 builds the self-contained Reports MCP App and also pins the copy hoisted for tsx. Keep the App build and tsx on this one governed compiler; remove the pin only after both consumers move away from it."
  },
  "wiring": {
    "makeTarget": "dependency-boundary",
    "checker": "scripts/check-dependency-boundary.mjs",
    "enterpriseAuditId": "dependency-boundary"
  }
}
