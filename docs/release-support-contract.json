{
  "schemaVersion": 1,
  "purpose": "Release, support, and security documentation contract for the SDK/CLI/MCP platform.",
  "policyDocument": {
    "path": "docs/release-support-policy.md",
    "mustContain": [
      "clockify-sdk-ts-115",
      "@apet97/clockify-cli-115",
      "@apet97/clockify-mcp-115",
      "make perfect-fast",
      "make perfect-full",
      "make pack-smoke",
      "npm publish",
      "SECURITY.md",
      "draft blocker",
      "completed sandbox live proof",
      "immediately before",
      "scripts/release-state.mjs",
      "scripts/registry-smoke.mjs",
      "proof_only",
      "published_now",
      "already_present_matching",
      "integrity_mismatch",
      "registrySmoke",
      "fsync",
      "atomic",
      "npm view dist.integrity",
      "no GitHub Release on dispatch",
      "receipt artifact",
      "receipt printed",
      "tag-push-only",
      "no live Clockify credentials",
      "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a",
      "$GITHUB_STEP_SUMMARY"
    ]
  },
  "releaseState": {
    "schemaVersion": 1,
    "requiredTopLevelFields": [
      "schemaVersion",
      "repository",
      "workflow",
      "runId",
      "runAttempt",
      "eventName",
      "refName",
      "sourceSha",
      "packageName",
      "version",
      "localArtifact",
      "publication",
      "verification",
      "timestamps",
      "finalStatus"
    ],
    "transitionCommands": [
      "init",
      "set-artifact",
      "proof-only",
      "publish",
      "registry-smoke",
      "attestation",
      "github-release",
      "fail"
    ],
    "atomicWriteRequirements": ["same-directory temporary file", "fsync", "rename"],
    "mismatchIsTerminal": true,
    "malformedReceiptExitCode": 2
  },
  "registrySmoke": {
    "script": "scripts/registry-smoke.mjs",
    "subcommands": ["sdk", "cli", "mcp"],
    "exactVersionRequired": true,
    "boundedTimeoutRequired": true,
    "cleanupRequired": true,
    "registryIntegrityQuery": "npm view dist.integrity"
  },
  "securityDocument": {
    "path": "SECURITY.md",
    "mustContain": [
      "clockify-sdk-ts-115",
      "@apet97/clockify-cli-115",
      "@apet97/clockify-mcp-115",
      "GitHub Security Advisories",
      "Do NOT open a public GitHub issue",
      "coordinated-disclosure"
    ],
    "forbiddenRegex": [
      "\\bnpm ls clockify-sdk-ts\\b",
      "\\bclockify-sdk-ts\\b(?!-115)"
    ]
  },
  "packageContract": {
    "path": "docs/package-contract.json",
    "packageNamesMustAppearInPolicy": true,
    "requiredMarkers": [
      "requiredScripts",
      "prepublishOnly"
    ]
  },
  "requiredMakeTargets": [
    "release-support-contract",
    "package-contract",
    "version-policy",
    "changelog-drift",
    "pack-smoke"
  ],
  "docsIndex": [
    "release-support-policy.md",
    "release-support-contract.json"
  ],
  "forbiddenPolicyMarkers": [
    "TODO",
    "TBD"
  ],
  "wiring": {
    "makeTarget": "release-support-contract",
    "qualityGate": "make release-support-contract",
    "inventoryId": "release-support-contract",
    "auditId": "release-support-contract"
  }
}
