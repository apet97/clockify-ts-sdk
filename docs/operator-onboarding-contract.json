{
  "schemaVersion": 1,
  "purpose": "Operator onboarding contract for non-coder bootstrap, SDK/CLI/MCP path selection, mock/live safety, stop conditions, and readiness boundaries.",
  "policyDocument": {
    "path": "docs/operator-onboarding.md",
    "mustContain": [
      "First five minutes",
      "Choose the path",
      "Generate a local plan",
      "Safe bootstrap sequence",
      "Mock versus live",
      "Stop conditions",
      "Readiness boundaries",
      "Readiness context",
      "readinessContext",
      "finalBlockingSignalIds",
      "blockingSignalIds",
      "riskRoutingSummary",
      "orderedProofChainCoverage",
      "node scripts/plan.mjs workflow --workflow first-run-support",
      "node scripts/plan.mjs onboarding --goal remote-mcp",
      "Remote MCP operator route",
      "clockify115-mcp-http",
      "clockify115-mcp-admin",
      "make mcp-remote-proof",
      "make mcp-container-service-proof",
      "make mcp-remote-live-proof",
      "all five report/App paths",
      "safeCommandHints",
      "Exit status: 0",
      "Result: passed",
      "prose success summary is not enough",
      "completed live sandbox proof",
      "no blocking residual risks"
    ],
    "forbiddenMarkers": [
      "TODO",
      "TBD"
    ]
  },
  "supportingDocs": [
    {
      "path": "docs/install-personas.md",
      "mustContain": [
        "SDK user",
        "CLI user",
        "MCP user",
        "make pack-smoke",
        "CLOCKIFY_BASE_URL"
      ]
    },
    {
      "path": "docs/developer-environment-policy.md",
      "mustContain": [
        "npm workspaces",
        "root `package.json`",
        "make sdk-codegen",
        "../GOCLMCP",
        "Do not confuse environment readiness with final product readiness"
      ]
    },
    {
      "path": "docs/dependency-policy.md",
      "mustContain": [
        "Package runtime floors",
        "Dependency boundaries",
        "Security posture"
      ]
    },
    {
      "path": "docs/mcp-remote-operations.md",
      "mustContain": [
        "clockify115-mcp-http",
        "clockify115-mcp-admin",
        "make mcp-remote-proof",
        "make mcp-container-service-proof",
        "make mcp-remote-live-proof",
        "report App envelopes or exact entitlement recovery"
      ]
    },
    {
      "path": "docs/live-tests.md",
      "mustContain": [
        "sacrificial sandbox",
        "make perfect-live",
        "Mock/replay proof never replaces live sandbox proof"
      ]
    }
  ],
  "planGenerator": {
    "path": "scripts/onboarding-plan.mjs",
    "makeTarget": "onboarding-plan",
    "mustContain": [
      "SDK user",
      "CLI user",
      "MCP user",
      "Remote MCP operator",
      "Mock/replay proof",
      "Live sandbox proof",
      "Full product readiness",
      "Support escalation",
      "network: \"none\"",
      "commandsExecuted: []",
      "envValuesCaptured: false",
      "node scripts/repo-doctor.mjs",
      "node scripts/plan.mjs workflow --workflow first-run-support",
      "clockify115-mcp-http --help",
      "clockify115-mcp-admin --help",
      "make mcp-remote-proof",
      "make mcp-container-service-proof",
      "make mcp-remote-live-proof",
      "node scripts/create-support-bundle.mjs --output /tmp/clockify-support-bundle.json",
      "readinessContext",
      "safeCommandHints",
      "finalBlockingSignalIds",
      "blockingSignalIds",
      "riskRoutingSummary",
      "orderedProofChainCoverage",
      "Exit status: 0",
      "Result: passed",
      "deferral is draft-only",
      "Does not run Git, npm, Docker, Fern, tests, builds, or Clockify API calls"
    ],
    "generatedPlan": {
      "exactFields": {
        "schemaVersion": 1,
        "goal": "all",
        "network": "none",
        "commandsExecuted": [],
        "envValuesCaptured": false,
        "secretsCaptured": false,
        "workspaceIdsCaptured": false
      },
      "requiredGoalIds": [
        "sdk",
        "cli",
        "mcp",
        "remote-mcp",
        "mock",
        "live",
        "full",
        "support"
      ],
      "requiredGoalArrayFields": [
        "firstReads",
        "safeStart",
        "proofWhenAllowed",
        "stopIf"
      ],
      "requiredGoalTextMarkers": {
        "remote-mcp": [
          "clockify115-mcp-http --help",
          "clockify115-mcp-admin --help",
          "make pack-smoke",
          "make mcp-remote-proof",
          "make mcp-container-service-proof",
          "make mcp-remote-live-proof",
          "CLOCKIFY_API_KEY",
          "CLOCKIFY_WORKSPACE_ID"
        ],
        "full": [
          "make perfect-full",
          "make perfect-live"
        ],
        "support": [
          "node scripts/plan.mjs workflow --workflow first-run-support",
          "readinessContext",
          "safeCommandHints",
          "riskRoutingSummary"
        ]
      }
    }
  },
  "requiredMakeTargets": [
    "onboarding-plan",
    "operator-onboarding",
    "developer-environment",
    "runtime-support",
    "package-contract",
    "pack-smoke",
    "mock-contract",
    "workflow-plan",
    "workflow-cookbook",
    "live-safety",
    "mcp-remote-proof",
    "mcp-container-service-proof",
    "mcp-remote-live-proof"
  ],
  "wiring": {
    "makeTarget": "operator-onboarding",
    "checker": "scripts/check-operator-onboarding.mjs",
    "docsIndex": [
      "operator-onboarding.md",
      "operator-onboarding-contract.json"
    ],
    "qualityGate": "make operator-onboarding",
    "inventoryId": "operator-onboarding",
    "auditId": "operator-onboarding"
  }
}
