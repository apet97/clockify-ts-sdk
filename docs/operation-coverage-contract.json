{
  "schemaVersion": 1,
  "purpose": "No-regression operation coverage baseline across corrected OpenAPI operations, SDK method stamps, TS MCP exact tool matches, GOCLMCP exact tool matches, and curated parity overrides. Every tsMcp:null parity row must carry a curated overrideReason, so an uncovered operation is always an explained decision. The goMcpExact floor is a tripwire against unnoticed sibling drift, not a coverage promise.",
  "policyDocument": {
    "path": "docs/operation-coverage-policy.md",
    "contains": [
      "Coverage baseline",
      "OpenAPI operations",
      "Generated SDK operations",
      "Explicitly named SDK operations",
      "OperationId-derived SDK operations",
      "TS MCP exact operation/tool matches",
      "GOCLMCP exact operation/tool matches",
      "Curated parity overrides",
      "Required escalation",
      "make operation-coverage"
    ],
    "forbiddenMarkers": [
      "TODO",
      "TBD"
    ]
  },
  "reportInputs": {
    "openapiOperations": "docs/openapi-operations.json",
    "operationParity": "docs/operation-parity.json",
    "operationDispositions": "docs/operation-dispositions.json",
    "sdkNamingClassifications": "docs/sdk-operation-naming-classifications.json",
    "operationEvidence": "docs/operation-evidence-map.json",
    "operationEvidenceAnchors": "docs/operation-evidence-anchor-inventory.json",
    "operationEvidenceSemantics": "docs/operation-evidence-semantic-contract.json",
    "correctedOpenapi": "spec/corrected/clockify.corrected.openapi.yaml",
    "discrepancyLedger": "spec/evidence/discrepancies.md",
    "sdkCodegenReceipt": "output/ts-sdk/codegen-receipt.json"
  },
  "generatedInputWiring": {
    "coveragePrerequisites": ["operation-parity-drift"],
    "coverageRecipes": [
      "$(MAKE) --no-print-directory operation-coverage-run"
    ],
    "coverageAggregateTarget": "operation-coverage-run",
    "coverageAggregatePrerequisites": [],
    "coverageAggregateRecipes": [
      "node --test scripts/operation-evidence-semantics.test.mjs",
      "node --test scripts/generate-operation-parity.test.mjs",
      "node scripts/check-operation-coverage.mjs"
    ],
    "sdkBuildTarget": "sdk-wrapper-build",
    "sdkBuildPrerequisites": ["sdk-codegen-sync"],
    "codegenTarget": "sdk-codegen-sync",
    "codegenRecipes": [
      "node scripts/generate-sdk-from-openapi.mjs --write",
      "cd wrapper && npm run sync"
    ]
  },
  "driftWiring": {
    "target": "operation-parity-drift",
    "requiredPrerequisites": [
      "mcp-tool-manifest-drift"
    ],
    "forbiddenPrerequisites": [
      "mcp-tool-manifest"
    ]
  },
  "manifestProofWiring": {
    "driftTarget": "mcp-tool-manifest-drift",
    "driftPrerequisites": [
      "sdk-wrapper-build"
    ],
    "driftRecipes": [
      "$(MAKE) --no-print-directory mcp-tool-manifest-drift-run"
    ],
    "driftExecutionTarget": "mcp-tool-manifest-drift-run",
    "driftExecutionPrerequisites": [],
    "driftExecutionRecipes": [
      "cd mcp && node --import tsx scripts/generate-tool-manifest.mjs --check"
    ],
    "writerTarget": "mcp-tool-manifest",
    "writerPrerequisites": [
      "sdk-wrapper-build"
    ],
    "writerRecipes": [
      "cd mcp && node --import tsx scripts/generate-tool-manifest.mjs --write"
    ]
  },
  "thresholds": {
    "operations": {
      "value": 168,
      "direction": "exact",
      "reason": "corrected OpenAPI operation count; docs/openapi-operations.json is the operation inventory truth this repo derives from",
      "changedOn": "2026-08-10"
    },
    "sdkGenerated": {
      "value": 168,
      "direction": "exact",
      "reason": "SDK codegen stamps exactly one reachable method per corrected operation",
      "changedOn": "2026-08-10"
    },
    "sdkExplicitlyNamed": {
      "value": 149,
      "direction": "exact",
      "reason": "the generated SDK split is exact: 168 reachable operations = 149 explicitly named + 19 operationId-derived",
      "changedOn": "2026-08-10"
    },
    "sdkOperationIdDerived": {
      "value": 19,
      "direction": "exact",
      "reason": "the generated SDK split is exact: 168 reachable operations = 149 explicitly named + 19 operationId-derived",
      "changedOn": "2026-08-10"
    },
    "tsMcpExact": {
      "value": 97,
      "direction": "floor",
      "reason": "no-regression floor for TS MCP operation/tool matches; drops from baseline must be intentional and reviewed",
      "changedOn": "2026-08-10"
    },
    "goMcpExact": {
      "value": 80,
      "direction": "floor",
      "reason": "tripwire against unnoticed GOCLMCP sibling drift, not a coverage promise",
      "changedOn": "2026-08-10"
    },
    "curated": {
      "value": 32,
      "direction": "floor",
      "reason": "no-regression floor for curated parity overrides; every tsMcp:null row must independently carry its own overrideReason",
      "changedOn": "2026-08-10"
    }
  },
