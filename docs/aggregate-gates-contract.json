{
  "schemaVersion": 1,
  "purpose": "Canonical exact-once contract for perfect-fast, perfect-full, and contract-gates across the recursively reached Make DAG and the production verify command plan.",
  "bounds": {
    "maxDepth": 64,
    "maxInvocations": 256,
    "maxTargetVisits": 4096,
    "maxRecipeLines": 4096,
    "maxCommandSegments": 16384,
    "maxCommandTokens": 32768,
    "maxPackageScripts": 4096,
    "maxCommandSourceCharacters": 1048576,
    "maxMakefileSourceCharacters": 1048576,
    "maxMakeDefinitions": 8192,
    "maxPrerequisites": 4096,
    "maxVerifyPlanEntries": 1024
  },
  "makefiles": {
    "allowedDirectories": [
      ".",
      "../GOCLMCP"
    ],
    "fallbacks": {
      "../GOCLMCP": "docs/aggregate-gates-goclmcp.Makefile"
    }
  },
  "reachedCommandPolicy": {
    "makeMarkers": "lexically inventory every standalone Make marker; each executable or dynamically evaluated marker must become a successfully parsed recursive invocation, with inert quoted run-make diagnostics classified explicitly",
    "strykerMarkers": "reject every reached raw source containing a Stryker executable marker before launcher interpretation",
    "npmExecPayloads": "walk npm exec and x payloads recursively through the same bounded command evaluator",
    "npmPrefixOptions": [
      "--prefix",
      "-C"
    ],
    "externalFallbackCondition": "use the committed fallback only when the external directory itself is absent"
  },
  "performanceTarget": "performance-budgets",
  "aggregates": {
