{
  "schemaVersion": 1,
  "purpose": "CI/workflow posture contract. Checks workflow safety rails, package pack guards, and local documentation.",
  "policyDocument": {
    "path": "docs/ci-policy.md",
    "mustContain": [
      "Current workflow roles",
      "CI safety rules",
      "make ci-contract",
      "Tag-only exact-artifact SDK release",
      "explicit maintainer approval",
      "scripts/release-state.mjs",
      "scripts/registry-smoke.mjs",
      "publish-capable workflows are tag-only",
      "manual proof surface",
      "origin/main",
      "make release-proof",
      "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a",
      "$GITHUB_STEP_SUMMARY"
    ],
    "forbiddenMarkers": [
      "TODO",
      "TBD"
    ]
  },
  "workflows": [
    {
      "path": ".github/workflows/ci.yml",
      "mustContain": [
        "name: Workspace CI",
        "node: [\"22.13.0\", \"24\"]",
        "package: wrapper",
        "package: cli",
        "package: mcp",
        "make sdk-codegen",
        "npm run build -w clockify-sdk-ts-115",
        "npm run lint -w",
        "npm run type-check -w",
        "npm test -w",
        "npm run build -w",
        "npm run build:smoke -w clockify-sdk-ts-115",
        "scripts/pack-snapshot.mjs --pkg=",
        "make contract-gates",
        "make sdk-codegen-drift sdk-codegen-test codegen-determinism",
        "build-determinism generator-comparison pack-smoke coverage mutation-ci",
        "node scripts/check-npm-audit.mjs",
        "persist-credentials: false",
        "workflow_dispatch: {}"
      ],
      "semantic": {
        "requireWorkflowDispatch": true,
        "topLevelPermissions": {
          "contents": "read"
        },
        "forbiddenRunPatterns": [
          "\\bnpm\\s+publish\\b"
        ],
        "forbiddenWorkflowPatterns": [
          "NODE_AUTH_TOKEN",
          "NPM_TOKEN",
          "secrets.CLOCKIFY_"
        ],
        "jobStepOrder": [
          {
            "job": "contracts",
            "require": [
              "make sdk-codegen",
              "make contract-gates",
              "make governance-audit",
              "make sdk-codegen-drift sdk-codegen-test codegen-determinism"
            ],
            "reason": "contract-gates and governance-audit read generated sources; sdk-codegen must run first or they silently pass against stale/missing output/ts-sdk. mustContain only asserts presence, not order, so a reorder used to stay green (T9)."
          }
        ]
      }
    },
    {
      "path": ".github/workflows/codeql.yml",
      "mustContain": [
        "name: CodeQL",
        "security-and-quality",
        "security-events: write",
        "github/codeql-action/init@5595ccaf912efad79be6eef63a5619ff05969be3",
        "github/codeql-action/analyze@5595ccaf912efad79be6eef63a5619ff05969be3",
        "- cli/src",
        "- mcp/src",
        "paths-ignore:",
        "- wrapper/src",
        ".github/workflows"
      ],
      "semantic": {
        "consistentActionPins": [
          {
            "action": "github/codeql-action",
            "variants": ["init", "analyze"],
            "reason": "CodeQL initialization and analysis must use one release commit."
          }
        ]
      }
    },
    {
      "path": ".github/workflows/docs.yml",
      "mustContain": [
        "name: Docs",
        "pages: write",
        "id-token: write",
        "make sdk-codegen",
        "npm run docs",
        "actions/deploy-pages"
      ]
    },
    {
      "path": ".github/workflows/release.yml",
      "mustContain": [
        "name: Release clockify-sdk-ts-115 to npm",
        "tags:",
        "fetch-depth: 0",
        "Verify release source is on origin/main",
        "git merge-base --is-ancestor \"$GITHUB_SHA\" refs/remotes/origin/main",
        "make contract-gates",
        "make release-proof",
        "make sdk-codegen-drift sdk-codegen-test",
        "Verify tag matches package version",
        "id-token: write",
        "make sdk-codegen",
        "scripts/release-publish.mjs",
        "scripts/release-attestation.mjs",
        "npm sbom",
        "Post-publish smoke install",
        "Initialize release receipt",
        "Pack exact artifact",
        "PACKAGE_TARBALL",
        "LOCAL_INTEGRITY",
        "scripts/release-state.mjs",
        "scripts/registry-smoke.mjs",
        "Generate required SBOM (SPDX JSON)",
        "Create or update GitHub release (+ attach required SBOM)",
        "Upload release receipt",
        "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a",
        "$GITHUB_STEP_SUMMARY"
      ],
      "forbiddenMarkers": [
        "workflow_dispatch"
      ]
    },
    {
      "path": ".github/workflows/ci-cli-release.yml",
      "mustContain": [
        "Release @apet97/clockify-cli-115 to npm",
        "cli-v*.*.*",
        "fetch-depth: 0",
        "Verify release source is on origin/main",
        "git merge-base --is-ancestor \"$GITHUB_SHA\" refs/remotes/origin/main",
        "make contract-gates",
        "make release-proof",
        "make sdk-codegen-drift sdk-codegen-test",
        "node-version: \"22.13.0\"",
        "working-directory: .",
        "npm run build -w clockify-sdk-ts-115",
        "Verify tag matches package version",
        "github.ref_type == 'tag'",
        "scripts/release-publish.mjs",
        "scripts/release-attestation.mjs",
        "Initialize release receipt",
        "Pack exact artifact",
        "PACKAGE_TARBALL",
        "LOCAL_INTEGRITY",
        "scripts/release-state.mjs",
        "scripts/registry-smoke.mjs",
        "Upload release receipt",
        "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a",
        "$GITHUB_STEP_SUMMARY",
        "persist-credentials: false"
      ],
      "forbiddenMarkers": [
        "workflow_dispatch"
      ]
    },
    {
      "path": ".github/workflows/ci-mcp-release.yml",
      "mustContain": [
        "Release @apet97/clockify-mcp-115 to npm",
        "mcp-v*.*.*",
        "fetch-depth: 0",
        "Verify release source is on origin/main",
        "git merge-base --is-ancestor \"$GITHUB_SHA\" refs/remotes/origin/main",
        "make contract-gates",
        "make release-proof",
        "node-version: \"22.13.0\"",
        "Verify package, manifest, tag, and SDK peer",
        "npm view \"clockify-sdk-ts-115@${SDK_VERSION}\" version",
        "make sdk-codegen-drift sdk-codegen-test",
        "npm run lint -w @apet97/clockify-mcp-115",
        "make mcp-tool-manifest-drift mcp-write-safety mcp-contract",
        "node scripts/check-npm-audit.mjs",
        "make mcpb-validate",
        "make mcpb-smoke",
        "make secret-hygiene",
        "mcp/clockify115-mcp-${MCP_VERSION}.mcpb",
        "mcp/clockify115-mcp-${MCP_VERSION}.spdx.json",
        "Create or update GitHub release",
        "Initialize release receipt",
        "Pack exact artifact",
        "PACKAGE_TARBALL",
        "LOCAL_INTEGRITY",
        "scripts/release-publish.mjs",
        "scripts/release-attestation.mjs",
        "scripts/release-state.mjs",
        "scripts/registry-smoke.mjs",
        "Upload release receipt",
        "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a",
        "$GITHUB_STEP_SUMMARY",
        "if: github.event_name == 'push' && github.ref_type == 'tag'",
        "persist-credentials: false"
      ],
      "forbiddenMarkers": [
        "workflow_dispatch"
      ]
    },
    {
      "path": ".github/workflows/sandbox-key-health.yml",
      "mustContain": [
        "name: Sandbox key health",
        "schedule:",
        "cron: \"0 7 * * 1\"",
        "workflow_dispatch:",
        "permissions:",
        "contents: read",
        "persist-credentials: false",
        "secrets.CLOCKIFY_API_KEY",
        "secrets.CLOCKIFY_WORKSPACE_ID",
        "node scripts/check-sandbox-key-health.mjs"
      ]
    },
    {
      "path": ".github/workflows/mutation.yml",
      "mustContain": [
        "name: Mutation",
        "workflow_dispatch:",
        "schedule:",
        "cron: \"0 5 * * 1\"",
        "target:",
        "type: choice",
        "node-version: \"22.13.0\"",
        "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
        "actions/setup-node@820762786026740c76f36085b0efc47a31fe5020",
        "make mutation",
        "npm run mutation -w clockify-sdk-ts-115",
        "npm run mutation -w @apet97/clockify-mcp-115",
        "npm run mutation -w @apet97/clockify-cli-115",
        "node scripts/check-mutation-score.mjs --package wrapper",
        "node scripts/check-mutation-score.mjs --package mcp",
        "node scripts/check-mutation-score.mjs --package cli",
        "Verify expected mutation reports",
        "cli/reports/mutation/mutation.json",
        "mutation-reports-${{ env.MUTATION_TARGET }}-${{ github.run_attempt }}",
        "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a",
        "if-no-files-found: error",
        "retention-days: 14",
        "persist-credentials: false",
        "fetch-depth: 0"
      ]
    }
  ],
  "retiredWorkflows": [
    {
      "path": ".github/workflows/ci-cli.yml",
      "reason": "Consolidated into the ci.yml package matrix. Retired 2026-07-14."
    },
    {
      "path": ".github/workflows/ci-mcp.yml",
      "reason": "Consolidated into the ci.yml package matrix. Retired 2026-07-14."
    },
    {
      "path": ".github/workflows/release-please.yml",
      "reason": "release-please.yml was retired 2026-07-27: it anchored on GitHub Releases and ignored .release-please-manifest.json, so every PR walked the packages backwards (0.13.0 -> 0.12.1, below what is already on npm). Releases are cut by pushing a prefixed wrapper-v*/cli-v*/mcp-v* tag."
    }
  ],
  "actionPinning": {
    "purpose": "Governs which workflows are held to immutable 40-hex SHA action pins. enforcedFor and knownUnpinned must together name every file in .github/workflows, so a NEW workflow cannot silently escape pinning by simply not being listed. knownUnpinned is a recorded gap with a closure target, NOT a standing exemption.",
    "enforcedFor": [
      ".github/workflows/ci.yml",
      ".github/workflows/release.yml",
      ".github/workflows/ci-cli-release.yml",
      ".github/workflows/ci-mcp-release.yml",
      ".github/workflows/mutation.yml",
      ".github/workflows/codeql.yml",
      ".github/workflows/docs.yml",
      ".github/workflows/sandbox-key-health.yml",
      ".github/workflows/workers-compat.yml"
    ],
    "knownUnpinnedClosureHistory": "The last three recorded gaps (codeql.yml, docs.yml, sandbox-key-health.yml -- 7 unpinned uses) were closed on 2026-07-28 with explicit maintainer approval for the .github/workflows/** change, and promoted into enforcedFor. Every workflow in the repo is now SHA-pinned, so knownUnpinned is empty by achievement rather than by omission. Re-adding an entry here is a regression that needs a recorded openRisk and closureTarget.",
    "knownUnpinned": []
  },
  "supportingDocs": [
    {
      "path": ".github/dependabot.yml",
      "mustContain": [
        "package-ecosystem: \"github-actions\"",
        "codeql-action:",
        "patterns: [\"github/codeql-action/*\"]"
      ]
    },
    {
      "path": "docs/release-support-policy.md",
      "mustContain": [
        "Do not change CI/CD",
        "npm publication is not the default path"
      ]
    },
    {
      "path": "scripts/release-decision-plan.mjs",
      "mustContain": [
        "network",
        "commandsExecuted",
        "explicitMaintainerApprovalRequired",
        "npm-via-ci"
      ]
    },
    {
      "path": "docs/risk-register.json",
      "mustContain": [
        "legacy-release-workflow-needs-maintainer-decision"
      ]
    },
    {
      "path": "AGENTS.md",
      "mustContain": [
        "Never run `npm publish`",
        ".github/workflows/**"
      ]
    }
  ],
  "crossWorkflowNodeVersion": {
    "sourceWorkflow": ".github/workflows/ci.yml",
    "sourceJob": "packages",
    "sourceStepRunContains": "pack-snapshot.mjs",
    "targetWorkflows": [
      ".github/workflows/release.yml",
      ".github/workflows/ci-cli-release.yml",
      ".github/workflows/ci-mcp-release.yml"
    ],
    "reason": "the packsnapshot leg's chosen Node version is the load-bearing part of that proof (R3b): a pack-snapshot check gathered at any Node version other than what release actually publishes with says nothing about what gets published, so the leg's version must equal every release workflow's node-version."
  },
  "wiring": {
    "makeTarget": "ci-contract",
    "checker": "scripts/check-ci-contract.mjs",
    "docsIndex": [
      "ci-policy.md",
      "ci-contract.json"
    ],
    "qualityGate": "make ci-contract",
    "inventoryId": "ci-contract",
    "auditId": "ci-contract"
  }
}
