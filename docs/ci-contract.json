{
  "schemaVersion": 1,
  "purpose": "CI/workflow posture contract. Checks workflow safety rails, package pack guards, and local documentation.",
  "policyDocument": {
    "path": "docs/ci-policy.md",
    "mustContain": [
      "Current workflow roles",
      "CI safety rules",
      "make ci-contract",
      "Legacy tag-triggered npm release path",
      "explicit maintainer approval"
    ],
    "forbiddenMarkers": [
      "TODO",
      "TBD"
    ]
  },
  "workflows": [
    {
      "path": ".github/workflows/ci.yml",
      "mustContain": [
        "name: Workspace CI",
        "node: [\"22.13.0\", \"24\"]",
        "package: wrapper",
        "package: cli",
        "package: mcp",
        "make sdk-codegen",
        "npm run build -w clockify-sdk-ts-115",
        "npm run lint -w",
        "npm run type-check -w",
        "npm test -w",
        "npm run build -w",
        "npm run build:smoke -w clockify-sdk-ts-115",
        "scripts/pack-snapshot.mjs --pkg=",
        "make contract-gates",
        "make sdk-codegen-drift sdk-codegen-test codegen-determinism",
        "build-determinism generator-comparison pack-smoke coverage mutation-ci",
        "node scripts/check-npm-audit.mjs",
        "persist-credentials: false"
      ]
    },
    {
      "path": ".github/workflows/codeql.yml",
      "mustContain": [
        "name: CodeQL",
        "security-and-quality",
        "security-events: write",
        "- cli/src",
        "- mcp/src",
        "paths-ignore:",
        "- wrapper/src",
        ".github/workflows"
      ]
    },
    {
      "path": ".github/workflows/docs.yml",
      "mustContain": [
        "name: Docs",
        "pages: write",
        "id-token: write",
        "make sdk-codegen",
        "npm run docs",
        "actions/deploy-pages"
      ]
    },
    {
      "path": ".github/workflows/release.yml",
      "mustContain": [
        "name: Release to npm",
        "tags:",
        "Verify tag matches package version",
        "id-token: write",
        "make sdk-codegen",
        "npm publish",
        "npm sbom",
        "Post-publish smoke install"
      ]
    },
    {
      "path": ".github/workflows/ci-cli-release.yml",
      "mustContain": [
        "Release @apet97/clockify-cli-115 to npm",
        "cli-v*.*.*",
        "workflow_dispatch",
        "node-version: \"22.13.0\"",
        "working-directory: cli",
        "npm run build -w clockify-sdk-ts-115",
        "Verify tag matches package version",
        "github.ref_type == 'tag'",
        "npm publish",
        "persist-credentials: false"
      ]
    },
    {
      "path": ".github/workflows/ci-mcp-release.yml",
      "mustContain": [
        "Release @apet97/clockify-mcp-115 to npm",
        "mcp-v*.*.*",
        "workflow_dispatch: {}",
        "node-version: \"22.13.0\"",
        "Verify package, manifest, tag, and SDK peer",
        "npm view \"clockify-sdk-ts-115@${SDK_VERSION}\" version",
        "make sdk-codegen-drift sdk-codegen-test",
        "npm run lint -w @apet97/clockify-mcp-115",
        "make mcp-tool-manifest-drift mcp-write-safety mcp-contract",
        "node scripts/check-npm-audit.mjs",
        "make mcpb-validate",
        "make mcpb-smoke",
        "make secret-hygiene",
        "mcp/clockify115-mcp-${MCP_VERSION}.mcpb",
        "mcp/clockify115-mcp-${MCP_VERSION}.spdx.json",
        "Create or update GitHub release",
        "dist.integrity",
        "if: github.event_name == 'push' && github.ref_type == 'tag'",
        "npm publish \"$PACKAGE_TARBALL\" --access public --provenance",
        "persist-credentials: false"
      ]
    },
    {
      "path": ".github/workflows/sandbox-key-health.yml",
      "mustContain": [
        "name: Sandbox key health",
        "schedule:",
        "cron: \"0 7 * * 1\"",
        "workflow_dispatch:",
        "permissions:",
        "contents: read",
        "persist-credentials: false",
        "secrets.CLOCKIFY_API_KEY",
        "secrets.CLOCKIFY_WORKSPACE_ID",
        "node scripts/check-sandbox-key-health.mjs"
      ]
    },
    {
      "path": ".github/workflows/mutation.yml",
      "mustContain": [
        "name: Mutation",
        "workflow_dispatch:",
        "target:",
        "type: choice",
        "node-version: \"22.13.0\"",
        "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
        "actions/setup-node@a0853c24544627f65ddf259abe73b1d18a591444",
        "make mutation",
        "npm run mutation -w clockify-sdk-ts-115",
        "npm run mutation -w @apet97/clockify-mcp-115",
        "npm run mutation -w @apet97/clockify-cli-115",
        "node scripts/check-mutation-score.mjs --package wrapper",
        "node scripts/check-mutation-score.mjs --package mcp",
        "node scripts/check-mutation-score.mjs --package cli",
        "Verify expected mutation reports",
        "cli/reports/mutation/mutation.json",
        "mutation-reports-${{ inputs.target }}-${{ github.run_attempt }}",
        "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a",
        "if-no-files-found: error",
        "retention-days: 14",
        "persist-credentials: false",
        "fetch-depth: 0"
      ]
    }
  ],
  "retiredWorkflows": [
    {
      "path": ".github/workflows/ci-cli.yml",
      "reason": "Consolidated into the ci.yml package matrix. Retired 2026-07-14."
    },
    {
      "path": ".github/workflows/ci-mcp.yml",
      "reason": "Consolidated into the ci.yml package matrix. Retired 2026-07-14."
    },
    {
      "path": ".github/workflows/release-please.yml",
      "reason": "release-please.yml was retired 2026-07-27: it anchored on GitHub Releases and ignored .release-please-manifest.json, so every PR walked the packages backwards (0.13.0 -> 0.12.1, below what is already on npm). Releases are cut by pushing a prefixed wrapper-v*/cli-v*/mcp-v* tag."
    }
  ],
  "actionPinning": {
    "purpose": "Governs which workflows are held to immutable 40-hex SHA action pins. enforcedFor and knownUnpinned must together name every file in .github/workflows, so a NEW workflow cannot silently escape pinning by simply not being listed. knownUnpinned is a recorded gap with a closure target, NOT a standing exemption.",
    "enforcedFor": [
      ".github/workflows/ci.yml",
      ".github/workflows/release.yml",
      ".github/workflows/ci-cli-release.yml",
      ".github/workflows/ci-mcp-release.yml",
      ".github/workflows/mutation.yml"
    ],
    "knownUnpinned": [
      {
        "path": ".github/workflows/codeql.yml",
        "unpinnedUses": [
          "github/codeql-action/init@v4",
          "github/codeql-action/analyze@v4"
        ],
        "openRisk": "A moving v4 tag on github/codeql-action can change analysis behaviour without a repo commit. Scope is the security-scanning job only; it publishes no artifact and holds no npm credential.",
        "closureTarget": "Pin to 40-hex SHAs. Deferred because pinning .github/workflows/** is a CI/CD change requiring explicit maintainer approval (AGENTS.md).",
        "discoveredBy": "ci-contract action-pinning coverage, 2026-07-28"
      },
      {
        "path": ".github/workflows/docs.yml",
        "unpinnedUses": [
          "actions/setup-node@v5",
          "actions/configure-pages@v6",
          "actions/upload-pages-artifact@v5",
          "actions/deploy-pages@v4"
        ],
        "openRisk": "Publishes GitHub Pages with pages:write and id-token:write. A compromised moving tag here reaches a deploy identity, so this is the highest-value of the three gaps.",
        "closureTarget": "Pin to 40-hex SHAs. Deferred pending explicit maintainer approval for a .github/workflows/** change.",
        "discoveredBy": "ci-contract action-pinning coverage, 2026-07-28"
      },
      {
        "path": ".github/workflows/sandbox-key-health.yml",
        "unpinnedUses": [
          "actions/setup-node@v5"
        ],
        "openRisk": "Runs with secrets.CLOCKIFY_API_KEY and secrets.CLOCKIFY_WORKSPACE_ID in scope, so a moving setup-node tag executes alongside live sandbox credentials.",
        "closureTarget": "Pin to a 40-hex SHA. Deferred pending explicit maintainer approval for a .github/workflows/** change.",
        "discoveredBy": "ci-contract action-pinning coverage, 2026-07-28"
      }
    ]
  },
  "supportingDocs": [
    {
      "path": "docs/release-support-policy.md",
      "mustContain": [
        "Do not change CI/CD",
        "npm publication is not the default path"
      ]
    },
    {
      "path": "scripts/release-decision-plan.mjs",
      "mustContain": [
        "network",
        "commandsExecuted",
        "explicitMaintainerApprovalRequired",
        "npm-via-ci"
      ]
    },
    {
      "path": "docs/risk-register.json",
      "mustContain": [
        "legacy-release-workflow-needs-maintainer-decision"
      ]
    },
    {
      "path": "AGENTS.md",
      "mustContain": [
        "Never run `npm publish`",
        ".github/workflows/**"
      ]
    }
  ],
  "wiring": {
    "makeTarget": "ci-contract",
    "checker": "scripts/check-ci-contract.mjs",
    "docsIndex": [
      "ci-policy.md",
      "ci-contract.json"
    ],
    "qualityGate": "make ci-contract",
    "inventoryId": "ci-contract",
    "auditId": "ci-contract"
  }
}
