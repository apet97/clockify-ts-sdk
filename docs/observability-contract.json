{
  "schemaVersion": 1,
  "purpose": "Cross-surface observability contract for request correlation, telemetry hooks, structured receipts, and safe support bundles.",
  "policyDocument": {
    "path": "docs/observability-policy.md",
    "mustContain": [
      "Observability is a product surface",
      "HEADER-001",
      "X-Request-Id",
      "Telemetry levels",
      "prepublish gate metadata",
      "package-lock metadata",
      "Redaction rules",
      "Use `<redacted>`",
      "role placeholders",
      "Do not jump from correlation to raw payload logging",
      "make observability"
    ],
    "forbiddenMarkers": [
      "TODO",
      "TBD"
    ]
  },
  "sdk": [
    {
      "path": "wrapper/composed-fetch.ts",
      "mustContain": [
        "REQUEST_ID_HEADER",
        "USER_AGENT_HEADER",
        "ComposedFetchHooks",
        "beforeRequest",
        "afterResponse",
        "onError",
        "onRetry",
        "getRequestIdFromError"
      ]
    },
    {
      "path": "wrapper/with-response.ts",
      "mustContain": [
        "withResponse",
        "requestId",
        "headers",
        "status",
        "withRawResponse"
      ]
    },
    {
      "path": "wrapper/otel-hooks.ts",
      "mustContain": [
        "otelHooks",
        "http.request.method",
        "http.response.status_code",
        "clockify.http.client.request.duration_ms",
        "peer.service"
      ]
    },
    {
      "path": "wrapper/tests/composed-fetch.test.ts",
      "mustContain": [
        "injects an X-Request-Id UUID per request by default",
        "hook rejections do NOT block the request"
      ]
    },
    {
      "path": "wrapper/tests/with-response.test.ts",
      "mustContain": [
        "returns data + response + headers + requestId + status"
      ]
    }
  ],
  "cli": [
    {
      "path": "cli/src/output.ts",
      "mustContain": [
        "ok: false",
        "code",
        "recoveryForCode",
        "retryableForCode"
      ]
    },
    {
      "path": "cli/tests/exit-contract.test.ts",
      "mustContain": [
        "--json",
        "retryable",
        "recovery"
      ]
    },
    {
      "path": "cli/src/receipt.ts",
      "mustContain": [
        "CliReceipt",
        "ids",
        "changed",
        "warnings",
        "next"
      ]
    }
  ],
  "mcp": [
    {
      "path": "mcp/src/result.ts",
      "mustContain": [
        "structuredContent",
        "changed",
        "warnings",
        "next",
        "recovery",
        "retryableForCode",
        "observeToolInvocation"
      ]
    },
    {
      "path": "mcp/src/tool-observability.ts",
      "mustContain": [
        "ToolOutcome",
        "configureToolObserver",
        "recordToolErrorOutcome",
        "observeToolInvocation",
        "WeakMap",
        "MAX_TOOL_DURATION_MS"
      ]
    },
    {
      "path": "mcp/src/output-schema.ts",
      "mustContain": [
        "MCP_RESULT_OUTPUT_SCHEMA",
        "structuredContent",
        "changed",
        "retryAfterSeconds"
      ]
    },
    {
      "path": "mcp/tests/server.test.ts",
      "mustContain": [
        "structured output schema",
        "canonical envelope",
        "structuredContent"
      ]
    },
    {
      "path": "mcp/src/http.ts",
      "mustContain": [
        "HttpRequestLog",
        "RemoteLogger",
        "http_request",
        "mcp_tool_outcome",
        "durationMs",
        "auth: AuthOutcome",
        "HttpFailure",
        "finishHttpRequest"
      ]
    },
    {
      "path": "mcp/src/http-mcp-post.ts",
      "mustContain": [
        "createMcpPostPipeline",
        "ingressRequestIdFromAuth",
        "withIngressRequestId",
        "observeTool",
        "requestId"
      ]
    },
    {
      "path": "mcp/src/http-main.ts",
      "mustContain": [
        "LifecycleLog",
        "DependencyLog",
        "MaintenanceLog",
        "service_lifecycle",
        "service_dependency",
        "pool_pressure",
        "service_maintenance",
        "shutdown_timeout"
      ]
    },
    {
      "path": "mcp/tests/remote-http.test.ts",
      "mustContain": [
        "correlates a sanitized request ID and logs no token, subject, body, or data",
        "emits one correlated, redacted tool outcome with only bounded fields",
        "does not let a failing logger alter a completed response"
      ]
    },
    {
      "path": "mcp/tests/tool-observability.test.ts",
      "mustContain": [
        "emits one bounded redacted outcome per successful and guarded-error invocation",
        "does not let observer failure alter the tool result",
        "keeps concurrent request observers isolated"
      ]
    },
    {
      "path": "mcp/src/remote/postgres.ts",
      "mustContain": [
        "PostgresPoolPressure",
        "onPoolPressure",
        "POOL_PRESSURE_DEDUPE_MS",
        "MAX_REPORTED_POOL_COUNT"
      ]
    },
    {
      "path": "mcp/tests/remote-postgres.test.ts",
      "mustContain": [
        "emits bounded pool counts only when PostgreSQL pool pressure exists",
        "deduplicates pool pressure, bounds counts, and contains observer failure"
      ]
    },
    {
      "path": "mcp/tests/remote-http-main.test.ts",
      "mustContain": [
        "remote HTTP binary configuration boundary",
        "service_lifecycle",
        "invalid_configuration"
      ]
    }
  ],
  "support": [
    {
      "path": "docs/support-runbook.md",
      "mustContain": [
        "Safe diagnostic bundle",
        "Prepublish gate",
        "Package-lock",
        "requestId",
        "Never include",
        "Proof attempted",
        "Escalation template"
      ]
    },
    {
      "path": "docs/data-handling-policy.md",
      "mustContain": [
        "Workspace identifiers",
        "Allowed placeholders",
        "Prohibited committed evidence",
        "<redacted>"
      ]
    },
    {
      "path": "docs/receipt-examples.md",
      "mustContain": [
        "SDK success receipt",
        "SDK error receipt",
        "CLI success receipt",
        "CLI error receipt",
        "MCP success receipt",
        "MCP recovery receipt",
        "Stable fields",
        "Review rule",
        "requestId",
        "retryable",
        "recovery"
      ],
      "forbiddenMarkers": [
        "sk-",
        "PASTE TOKEN"
      ]
    },
    {
      "path": "docs/receipts-policy.md",
      "mustContain": [
        "X-Request-Id",
        "withResponse",
        "structuredContent",
        "retryable"
      ]
    },
    {
      "path": "docs/mcp-remote-operations.md",
      "mustContain": [
        "Health, logs, and incident response",
        "one-line JSON request logs",
        "service_dependency",
        "service_maintenance",
        "safe alert dimensions",
        "make mcp-remote-proof"
      ],
      "forbiddenMarkers": [
        "TODO",
        "TBD"
      ]
    }
  ],
  "redaction": [
    {
      "path": "docs/observability-policy.md",
      "mustContain": [
        "Redaction rules",
        "Use `<redacted>`",
        "role placeholders",
        "Raw Clockify bodies are a"
      ]
    },
    {
      "path": "docs/data-handling-policy.md",
      "mustContain": [
        "Prohibited committed evidence",
        "Raw package-lock dependency names",
        "<redacted>"
      ]
    },
    {
      "path": "docs/support-bundle-contract.json",
      "mustContain": [
        "redaction",
        "package-lock",
        "readinessContext"
      ]
    }
  ],
  "supportingContracts": [
    {
      "path": "docs/error-codes.json",
      "mustContain": [
        "retryable",
        "recovery"
      ]
    },
    {
      "path": "docs/mcp-contract.json",
      "mustContain": [
        "outputSchema",
        "resources",
        "prompts"
      ]
    },
    {
      "path": "docs/cli-contract.json",
      "mustContain": [
        "exitCodes",
        "globalFlags"
      ]
    }
  ],
  "requiredMakeTargets": [
    "observability",
    "data-handling",
    "support-bundle"
  ],
  "wiring": {
    "makeTarget": "observability",
    "docsIndex": [
      "observability-policy.md",
      "observability-contract.json"
    ],
    "qualityGate": "make observability",
    "inventoryId": "observability",
    "auditId": "observability-contract"
  }
}
