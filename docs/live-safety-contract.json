{
  "schemaVersion": 2,
  "purpose": "Live Clockify test safety contract for the aggregate SDK, CLI, MCP, and GOCLMCP proof. Guards workspace confirmation, exclusive locking, result aggregation, cleanup, and secret-free receipts.",
  "policyDocument": {
    "path": "docs/live-tests.md",
    "mustContain": [
      "Never run live gates against a customer workspace",
      "CLOCKIFY_API_KEY",
      "CLOCKIFY_WORKSPACE_ID",
      "CLOCKIFY_LIVE_WORKSPACE_CONFIRM",
      "CLOCKIFY_LIVE_PREFIX",
      "make perfect-live",
      "make mcp-remote-live-proof",
      "make live-evidence-campaign",
      "sanitized JSON receipt",
      "zero leftovers",
      "DEFER_LIVE_REASON",
      "make mock-clockify"
    ],
    "forbiddenMarkers": [
      "TODO",
      "TBD"
    ]
  },
  "sandboxFingerprint": {
    "path": "docs/live-sandbox-fingerprint.json",
    "mustContain": [
      "\"schemaVersion\": 1",
      "\"algorithm\": \"sha256\"",
      "\"workspaceIdSha256\"",
      "Non-reversible identity pin",
      "Never replace this from ambient credentials"
    ]
  },
  "makefile": {
    "path": "Makefile",
    "mustContain": [
      "perfect-live: live-safety test-data-lifecycle sdk-wrapper-build",
      "node scripts/run-live-proof.mjs",
      "live-evidence-campaign: live-safety test-data-lifecycle",
      "node scripts/live/run-live-evidence-campaign.mjs",
      "mcp-remote-live-proof: mcp-remote-proof live-safety test-data-lifecycle sdk-wrapper-build",
      "node mcp/scripts/remote-live-proof.mjs"
    ],
    "forbiddenMarkers": [
      "cd mcp && npm run verify:live-cleanup",
      "cd ../GOCLMCP && $(MAKE) perfect-live"
    ]
  },
  "orchestrator": {
    "path": "scripts/live/orchestrator.mjs",
    "mustContain": [
      "/tmp/clockify115-live.lock",
      "CLOCKIFY_LIVE_WORKSPACE_CONFIRM",
      "clockify115-live-",
      "wrapper",
      "cli",
      "mcp",
      "goclmcp",
      "finally",
      "cleanupLivePrefixes",
      "outputSha256",
      "live_lock_active",
      "live_lock_not_stale",
      "live_lock_reap_active",
      "terminateProcessTree",
      "SIGKILL",
      "createBoundedLiveClient",
      "LIVE_REQUEST_TIMEOUT_SECONDS",
      "LIVE_CLEANUP_BUDGET_MS",
      "maxRetries: 0",
      "CLOCKIFY_ADDON_TOKEN: \"\"",
      "CLOCKIFY_BASE_URL: \"\"",
      "CLOCKIFY_REGION: \"\"",
      "CLOCKIFY_SUBDOMAIN: \"\"",
      "live_routing_override_forbidden",
      "CLOCKIFY_HOME: isolatedHome",
      "2000-01-01T00:00:00.000Z",
      "2100-01-01T00:00:00.000Z"
    ]
  },
  "orchestratorTests": {
    "path": "scripts/live/orchestrator.test.mjs",
    "mustContain": [
      "all four surfaces run after a failure",
      "malformed lock files fail closed",
      "only explicit 402/feature-unavailable markers",
      "recovery lock prevents concurrent stale-lock reaping",
      "already-aborted proof dispatches no surface",
      "campaign cleanup budget bounds repeated request timeouts below the launcher grace",
      "cleanup actions are projected to count-only receipt fields"
    ]
  },
  "entrypoint": {
    "path": "scripts/run-live-proof.mjs",
    "mustContain": [
      "AbortController",
      "SIGINT",
      "SIGTERM",
      "runLiveProof({ signal: controller.signal })",
      "JSON.stringify(receipt)"
    ]
  },
  "cleanupLibrary": {
    "path": "scripts/live/cleanup.mjs",
    "mustContain": [
      "CLEANUP_ENTITY_ORDER",
      "cleanupLivePrefixes",
      "cleanup_deadline_exceeded",
      "sanitizedIdCount",
      "remainingCount"
    ]
  },
  "cleanupTests": {
    "path": "scripts/live/cleanup.test.mjs",
    "mustContain": [
      "node:test",
      "cleanupLivePrefixes",
      "a shared deadline bounds repeated stalled cleanup calls across all entity classes"
    ]
  },
  "projectProbe": {
    "path": "scripts/live/project-update-omission-probe.mjs",
    "mustContain": [
      "validateLiveEnvironment",
      "acquireLiveLock",
      "createBoundedLiveClient",
      "cleanupLivePrefixes",
      "LIVE_CLEANUP_BUDGET_MS",
      "releaseLiveLock",
      "cleanupReceipt.leftovers === 0"
    ]
  },
  "remoteLiveProof": {
    "path": "mcp/scripts/remote-live-proof.mjs",
    "mustContain": [
      "validateLiveEnvironment(env)",
      "acquireLiveLock()",
      "releaseLiveLock(lock)",
      "cleanupLivePrefixes({",
      "credential\", \"set",
      "clockify_status",
      "clockify_demo_seed",
      "clockify_demo_cleanup",
      "confirmationCount(database)",
      "requireZeroCleanupPreview(rescan)",
      "zero-tenant-rows"
    ]
  },
  "remoteLiveReports": {
    "path": "mcp/scripts/remote-live-proof-reports.mjs",
    "mustContain": [
      "clockify_reports_summary",
      "clockify_reports_detailed",
      "clockify_reports_weekly",
      "clockify_reports_attendance",
      "clockify_reports_expense",
      "isReportsAppModel(model)",
      "REPORT_MODEL_LIMIT"
    ]
  },
  "campaignLauncher": {
    "path": "scripts/live/run-live-evidence-campaign.mjs",
    "mustContain": [
      "validateTrackedBaseline",
      "buildSdkArtifact",
      "buildVerifiedSdkArtifact",
      "writeByteSnapshot",
      "live_campaign_snapshot_changed",
      "live_campaign_cleanup_timeout",
      "runChildWithGracefulTermination",
      "sanitizedOutput",
      "validateCampaignReceipt"
    ]
  },
  "campaignAttestation": {
    "path": "scripts/live/live-evidence-attestation.mjs",
    "mustContain": [
      "GOVERNED_SAFETY_DEMOTIONS",
      "EXPECTED_CLEANUP_ACTIONS",
      "previousManifestSha256",
      "scanForSecretLikeData",
      "validateApprovalReceipt"
    ]
  },
  "campaignTests": {
    "path": "scripts/live/run-live-evidence-campaign.test.mjs",
    "mustContain": [
      "byte snapshots contain only the supplied immutable bytes",
      "byte snapshots reject traversal and non-byte inputs",
      "SDK build rejects campaign inputs that change during the build",
      "worker timeout requests graceful cleanup before exit",
      "launcher main path uses the shared cleanup grace constant",
      "launcher output redacts every occurrence"
    ]
  },
  "verifyRunner": {
    "path": "scripts/verify.mjs",
    "mustContain": [
      "CLOCKIFY_LIVE_WORKSPACE_CONFIRM: \"\"",
      "CLOCKIFY_LIVE_PREFIX: \"\"",
      "CLOCKIFY_RUN_LIVE_E2E: \"\"",
      "CLOCKIFY_LIVE_WORKSPACE_CONFIRM: process.env.CLOCKIFY_LIVE_WORKSPACE_CONFIRM"
    ]
  },
  "riskRegister": {
    "path": "docs/risk-register.json",
    "mustContain": [
      "live-tests-sandbox-only",
      "customer workspaces"
    ]
  },
  "docsIndex": [
    "live-tests.md",
    "live-safety-contract.json",
    "live-sandbox-fingerprint.json"
  ],
  "wiring": {
    "makeTarget": "live-safety",
    "qualityGate": "make live-safety",
    "inventoryId": "live-safety",
    "auditId": "live-safety"
  }
}
