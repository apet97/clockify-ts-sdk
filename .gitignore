# macOS
.DS_Store

# Java SDK reference is a separate clone of clockify/addon-java-sdk
# kept locally for cross-checking only; not part of this repo.
java-sdk-reference/

# Live API probe captures — local evidence only. Promote anything
# canonical into spec/evidence/discrepancies.md and reference the
# probe by relative path; the raw bodies don't ship.
spec/evidence/probes/*.json
spec/evidence/probes/*.hdr
!spec/evidence/probes/README.md

# Build artifacts inside wrapper/ are managed by wrapper/.gitignore;
# this rule pins node_modules at any nesting level just in case.
**/node_modules/
node_modules
**/coverage/
**/*.tsbuildinfo

# Local TypeScript generator output. Regenerable from spec/corrected/ via
#   make sdk-codegen
# without Docker or a hosted SDK generator. See CONTRIBUTING.md for the
# repo-owned generation chain.
/output/ts-sdk/

# TypeDoc output for the public API reference (Phase 3.3) lands
# at the REPO ROOT under docs/api/. Keep source-authored docs in
# docs/ trackable.
/docs/api/

# IDE / editor noise
.idea/
.vscode/
*.swp
# Local editor and assistant state.
.claude/

# Local scratch output.
/.worktrees/

# Local env files — never commit secrets (CLOCKIFY_API_KEY etc.). The
# secret-hygiene gate is best-effort and self-disclaims completeness, so keep
# .env uncommittable outright. A committed template stays allowed.
.env
.env.*
!.env.example

# Local remote-MCP secret mounts. Only the Compose definition is committed.
/deploy/mcp-remote/secrets/

# Built MCP one-click install bundle (produced by `make mcpb`). The artifact is
# rebuildable from source and intentionally not committed; distribution is a
# separate maintainer decision.
*.mcpb
mcp/clockify115-mcp-*.spdx.json
mcp/clockify115-mcp-*.build.json

# Manifest-derived runtime constants. Generated before test/type-check/build.
/wrapper/generated/
/cli/src/generated/
/mcp/src/generated/

# Working output of scripts/live/generate-live-evidence-manifest.mjs --
# local scratch only; the real destination is spec/evidence/live-evidence-
# manifest.json, imported via scripts/import-live-evidence-manifest.mjs
# with explicit hash verification, never copied here directly.
/scripts/live/.manifest-work/

# Local pack artifacts from make pack-smoke.
*.tgz
